{{#extend "body_id"}}id="random"{{/extend}}
{{#extend "body"}}
<a href="/movie/{{ random }}">
    <h1>Picking Random Movie</h1>
</a>
<h2></h2>
{{/extend}}
{{#extend "js"}}
<script src="js/text-scramble.js"></script>
<script>
    const API_KEY = `{{ api_key }}`;
    const id = `{{ random }}`;

    let url = `https://api.themoviedb.org/3/movie/${id}?api_key=${API_KEY}&language=en-US`;
    fetch(url, {
        method: 'GET'
    }).then(res => res.json())
        .then((response) => {

            const title = document.querySelector('h1');
            const titleFX = new TextScramble(title);

            const streaming = document.querySelector('h2');
            const streamingFX = new TextScramble(streaming);
            setTimeout(() => { titleFX.setText(response.title) }, 1000);
            // setTimeout(() => { streamingFX.setText(`Streaming on : ${response.homepage}`) }, 2000);
        })
        .catch(error => console.error('Error:', error));


</script>
{{/extend}}