{{#extend "body_id"}}
id="movies"
{{/extend}}
{{#extend "body"}}
<div class="container">
    <div class="row">
        <h1>Selected Movies</h1>
    </div>
    <div class="movies row"></div>
</div>
{{/extend}}

{{#extend "js"}}
<script>
    const API_KEY = `{{ api_key }}`;
    const movies = {
        init: () => {
            movies.getList();
        },
        getList: () => {
            fetch(`/list/`, {
                method: 'GET'
            }).then(res => res.json())
                .then((response) => {
                    movies.list = response;
                    for (const movie of response) {
                        console.log(movie);
                        movies.getDetails(Number(movie.movie_id));
                    }
                })
                .catch(error => console.error('Error:', error));
        },
        getDetails: (id) => {
            let url = `https://api.themoviedb.org/3/movie/${id}?api_key=${API_KEY}&language=en-US`;
            fetch(url, {
                method: 'GET'
            }).then(res => res.json())
                .then((response) => {

                    console.log(response);
                    const html = `<div class="col-3 movie">
                        <div class="poster"
                            style="background-image: url(https://image.tmdb.org/t/p/w500/${response.poster_path})">
                            <div class="details">
                                <a href="/movie/${response.id}"><i class="fal fa-info-circle"></i></a>
                                <a href="#" data-id="${response.id}" class="watched"><i class="fal fa-check-circle"></i></a>
                            </div>
                        </div>
                    </div>`;
                    document.querySelector('.movies').innerHTML += html;
                })
                .catch(error => console.error('Error:', error));
        }
    }
    movies.init();
</script>
{{/extend}}