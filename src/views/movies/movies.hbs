{{#extend "body_id"}}
id="movies"
{{/extend}}
{{#extend "body"}}
<div class="container">
    <div class="row">
        <div class="col-4">
            <h1>Selected Movies (<span class="total">{{ total }}</span>)</h1>
        </div>
        <div class="col-8">
            <div class="watch-status">
                <a href="/movies/unwatched/" class="unwatched">Unwatched</a>
                <a href="/movies/watched/" class="watched">Watched</a>
            </div>
        </div>
    </div>
    {{!-- <div class="row genres">
        <ul>
            <li class="all selected" data-name="all">All</li>
        </ul>
    </div> --}}
    <div class="movies row"></div>

    <div class="row pagination">
        <ul></ul>
    </div>
</div>
{{/extend}}

{{#extend "js"}}
<script>

    // TODO : Move this all to the back-end, and do proper filtering

    const API_KEY = `{{ api_key }}`;
    const movies = {
        length: Number(`{{ total }}`),
        page: 1,
        watched: Number(`{{ watch }}`),
        init: () => {
            movies.getList();

            if (movies.watched === 0) {
                document.querySelector('.unwatched').classList.add('selected');
            } else {
                document.querySelector('.watched').classList.add('selected');
            }

            let pages = Math.ceil(movies.length / 16);

            for (let i = 0; i < pages; i += 1) {
                document.querySelector('.pagination ul').innerHTML += `<li data-page="${i + 1}">${i + 1}</li>`;
            }

            document.querySelectorAll('.pagination ul li')[0].classList.add('selected');

            document.querySelectorAll('.pagination ul li').forEach(li => li.addEventListener('click', () => {
                const selected = event.currentTarget;
                selected.classList.add('selected');
                movies.page = selected.getAttribute('data-page');
                movies.getList();
            }));


            document.querySelectorAll('.filter').forEach((filter) => {
                filter.addEventListener('click', (event) => {
                    const section = event.currentTarget.innerHTML.toLowerCase();

                    document.querySelectorAll('.filter').forEach(filter => filter.classList.remove('selected'));
                    event.currentTarget.classList.add('selected');
                    movies.page = 1;
                    movies.watched = (section === 'unwatched') ? 0 : 1;

                    movies.getList();
                });
            });

        },
        getList: () => {
            fetch(`/list/${movies.watched}/${movies.page}`, {
                method: 'GET'
            }).then(res => res.json())
                .then((response) => {
                    document.querySelector('.movies').innerHTML = '';

                    movies.list = response.sort();

                    for (const [index, movie] of response.entries()) {
                        movies.getDetails(Number(movie.movie_id), movie.watched, index);
                    }

                    document.querySelector('.total').innerHTML = movies.length;


                })
                .catch(error => console.error('Error:', error));
        },
        getDetails: (id, watched, index) => {
            let url = `https://api.themoviedb.org/3/movie/${id}?api_key=${API_KEY}&language=en-US`;
            fetch(url, {
                method: 'GET'
            }).then(res => res.json())
                .then((response) => {
                    const html = `<div class="col-12 col-sm-6 col-md-6 col-lg-6 col-xl-3 movie" style="order:${index}">
                        <a href="/movie/${response.id}" title="${response.original_title}">
                            <div class="poster">
                                <img src="https://image.tmdb.org/t/p/w500/${response.poster_path}">
                                <div class="details">
                                    <div class="title">${response.title} <span>(${response.original_language})</span></div>
                                    <div class="runtime">${response.runtime}<span>Minutes</span></div>
                                    <div class="rating"><i class="fad fa-star"></i> ${response.vote_average}</div>
                                </div>
                            </div>
                        </a>
                    </div>`;
                    document.querySelector('.movies').innerHTML += html;

                })
                .catch(error => console.error('Error:', error));
        }
    }

    movies.init();



</script>
{{/extend}}