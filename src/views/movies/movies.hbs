{{#extend "body_id"}}
id="movies"
{{/extend}}
{{#extend "body"}}
<main>
    <div class="container">
        <div class="movies row justify-content-center">

        </div>
    </div>
</main>
{{/extend}}

{{#extend "js"}}
<script>
    const API_KEY = `{{ api_key }}`;
    const movies = {
        init: () => {
            movies.getList();
        },
        getList: () => {
            fetch(`/list/`, {
                method: 'GET'
            }).then(res => res.json())
                .then((response) => {
                    movies.list = response;
                    for (const movie of response) {
                        console.log(movie);
                        movies.getDetails(Number(movie.movie_id));
                    }
                })
                .catch(error => console.error('Error:', error));
        },
        getDetails: (id) => {
            let url = `https://api.themoviedb.org/3/movie/${id}?api_key=${API_KEY}&language=en-US`;
            fetch(url, {
                method: 'GET'
            }).then(res => res.json())
                .then((response) => {

                    console.log(response);
                    const html = ` <div class="col-3">
                        <a href="/movie/${response.id}">
                            <img src="https://image.tmdb.org/t/p/w500/${response.poster_path}" />
                        </a>
                    </div>`;
                    document.querySelector('.movies').innerHTML += html;
                })
                .catch(error => console.error('Error:', error));
        }
    }
    movies.init();
</script>
{{/extend}}