{{#extend "body_id"}}
id="movies"
{{/extend}}
{{#extend "body"}}
<div class="container">
    <div class="row">
        <div class="col-4">
            <h1>Selected Movies (<span class="total"></span>)</h1>
        </div>
        <div class="col-8">
            <div class="watch-status">
                <div class="unwatched selected filter">Unwatched</div>
                <div class="watched filter">Watched</div>
            </div>
        </div>
    </div>
    <div class="row genres">
        <ul>
            <li class="all selected" data-name="all">All</li>
        </ul>
    </div>
    <div class="movies row unwatched"></div>
</div>
{{/extend}}

{{#extend "js"}}
<script>

    // TODO : Move this all to the back-end, and do proper filtering

    const API_KEY = `{{ api_key }}`;
    const movies = {
        genres: [],
        length: 0,
        unwatched: 0,
        watched: 0,
        fetchCount: 0,
        filtering: 'unwatched',
        init: () => {
            movies.getList();
        },
        getList: () => {
            fetch(`/list/`, {
                method: 'GET'
            }).then(res => res.json())
                .then((response) => {
                    movies.list = response;
                    movies.length = movies.list.length;

                    for (const movie of response) {
                        movies.getDetails(Number(movie.movie_id), movie.watched);
                        if (movie.watched === '1') {
                            movies.watched++;
                        } else {
                            movies.unwatched++;
                        }
                    }
                    document.querySelector('.total').innerHTML = movies.unwatched;
                })
                .catch(error => console.error('Error:', error));
        },
        getDetails: (id, watched) => {
            let url = `https://api.themoviedb.org/3/movie/${id}?api_key=${API_KEY}&language=en-US`;
            fetch(url, {
                method: 'GET'
            }).then(res => res.json())
                .then((response) => {

                    watched = (watched == 1) ? 'watched' : 'unwatched';
                    let genres = [];

                    for (const genre of response.genres) {
                        let name = genre.name.toLowerCase();
                        name = name.replace(' ', '-');
                        genres.push(name);
                        movies.genres.push(genre)
                    }

                    const html = `<div class="col-12 col-sm-6 col-lg-3 movie ${genres.toString().replaceAll(',', ' ')}" data-watched="${watched}">
                        <div class="poster"
                            style="background-image: url(https://image.tmdb.org/t/p/w500/${response.poster_path})">
                            <div class="details">
                                <a href="/movie/${response.id}" class="about">About</a>
                                <a href="#" data-id="${response.id}" class="${watched}">${watched}</a>
                            </div>
                        </div>
                    </div>`;

                    movies.fetchCount++;

                    if (movies.fetchCount === movies.length) {
                        const genres = combinedItems(movies.genres);
                        for (const genre of genres) {
                            document.querySelector('.genres ul').innerHTML += `<li data-name="${genre.name.toLowerCase().replace(' ', '-')}">${genre.name}</li>`;
                        }

                        document.querySelectorAll('.genres li').forEach((genre) => {
                            genre.addEventListener('click', () => {
                                let genre_name = event.currentTarget.getAttribute('data-name');

                                document.querySelectorAll('.genres li').forEach(genre => genre.classList.remove('selected'));
                                document.querySelectorAll(`.movie`).forEach(movie => movie.classList.remove('hide'));

                                event.currentTarget.classList.add('selected');

                                if (genre_name !== 'all') {
                                    document.querySelectorAll(`.movie:not(.${genre_name})`).forEach(movie => movie.classList.add('hide'));
                                }

                                document.querySelector('.total').innerHTML = document.querySelectorAll(`.movie[data-watched="${movies.filtering}"]:not(.hide)`).length;
                            });
                        });

                    }

                    document.querySelector('.movies').innerHTML += html;

                })
                .catch(error => console.error('Error:', error));
        }
    }
    movies.init();

    const combinedItems = (arr = []) => {
        const res = arr.reduce((acc, obj) => {
            let found = false;
            for (let i = 0; i < acc.length; i++) {
                if (acc[i].id === obj.id) {
                    found = true;
                    acc[i].count++;
                };
            }
            if (!found) {
                obj.count = 1;
                acc.push(obj);
            }
            return acc;
        }, []);
        return res;
    }

    document.querySelectorAll('.filter').forEach((filter) => {
        filter.addEventListener('click', (event) => {
            movies.filtering = event.currentTarget.innerHTML.toLowerCase();
            document.querySelectorAll('.filter').forEach(filter => filter.classList.remove('selected'));
            event.currentTarget.classList.add('selected');
            document.querySelector('.movies').classList.remove('watched');
            document.querySelector('.movies').classList.remove('unwatched');
            document.querySelector('.movies').classList.add(movies.filtering);
            document.querySelector('.total').innerHTML = document.querySelectorAll(`.movie[data-watched="${movies.filtering}"]:not(.hide)`).length;

        });
    })


</script>
{{/extend}}