{{#extend "body_id"}}
id="trending"
{{/extend}}
{{#extend "title"}}
Trending -
{{/extend}}
{{#extend "body"}}

<div id="movies">
    <div class="container">
        <div class="row">
            <h1>Trending <span>Movies</span></h1>
        </div>
        <div class="row">
            {{#each trending.results}}

            {{log this}}
            {{#if this.poster_path}}
            <div class="col-12 col-sm-6 col-lg-3 movie ">
                <a href="/movie/{{this.id}}" title="{{this.original_title}}">
                    <div class="poster">
                        <img src="https://image.tmdb.org/t/p/w500/{{ this.poster_path }}">
                        <div class="details">
                            <div class="title">{{ this.title }} <span>({{this.original_language}})</span></div>
                            <div class="runtime">{{this.runtime}}<span>Minutes</span></div>
                            <div class="rating"><i class="fad fa-star"></i> {{this.vote_average}}</div>
                        </div>
                    </div>
                </a>
            </div>
            {{/if}}
            {{/each}}
        </div>
    </div>
</div>
{{/extend}}

{{#extend "js"}}
<script>
    const movies = {
        fadeOut: null,
        add: (id, title) => {
            const data = {
                movie_id: id,
                watched: 0
            };
            fetch(`/add/`, {
                method: 'POST',
                body: JSON.stringify(data),
                headers: {
                    'Content-type': 'application/json'
                }

            }).then(res => res.json())
                .then((response) => {
                    document.querySelector('.added span').innerHTML = title;
                    document.querySelector('.added').classList.add('is-showing');
                    movies.fadeOut = setTimeout(() => {
                        document.querySelector('.added').classList.remove('is-showing');
                    }, 5000);
                })
                .catch(error => console.error('Error:', error));
        },
    }

    document.querySelectorAll('.add').forEach(add => add.addEventListener('click', (event) => {
        let id = event.currentTarget.getAttribute('data-id');
        let title = event.currentTarget.getAttribute('data-title');
        document.querySelector('.added').classList.remove('is-showing');
        event.currentTarget.innerHTML = 'unwatched';
        clearTimeout(movies.fadeOut);
        movies.add(id, title);

    }));
</script>
{{/extend}}