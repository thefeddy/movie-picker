<div class="screen">
    <h1>Search</h1>
    <div class="bg"></div>

    <div class="search">
        <form action="/search/">
            <i class="fal fa-search"></i>
            <input type="text" placeholder="Search for a Movie">
            <i class="fal fa-times"></i>
        </form>
    </div>
</div>

{{/extend}}

{{#extend "js"}}
<script>
    document.querySelector('.search input').addEventListener('keyup', (event) => {
        if (event.currentTarget.value != '') {
            document.querySelector('.fa-times').classList.add('is-showing');
        } else {
            document.querySelector('.fa-times').classList.remove('is-showing');
        }
    });

    document.querySelector('.fa-times').addEventListener('click', () => {
        document.querySelector('.fa-times').classList.remove('is-showing');
        document.querySelector('.search input').value = '';
    });

    document.querySelector('.search form').addEventListener('submit', (event) => {
        event.preventDefault();
        let search = encodeURIComponent(document.querySelector('.search input').value);
        window.location.href = `/search/${search}/1`;
    });


    const backgrounds = document.querySelectorAll('.crt img');

    document.querySelectorAll('.crt img')[0].classList.add('is-showing');
    const author = document.querySelectorAll('.crt img')[0].getAttribute('data-author');
    const url = document.querySelectorAll('.crt img')[0].getAttribute('data-url');

    const about = document.querySelector('.crt p a');
    about.setAttribute('href', url)
    about.innerHTML = author;


    let current = 0;
    setInterval(() => {
        document.querySelectorAll('.crt img')[current].classList.remove('is-showing');
        if (current === document.querySelectorAll('.crt img').length - 1) {
            current = 0;
        } else {
            current += 1;
        }


        document.querySelectorAll('.crt img')[current].classList.add('is-showing');
        const author = document.querySelectorAll('.crt img')[current].getAttribute('data-author');
        const url = document.querySelectorAll('.crt img')[current].getAttribute('data-url');

        const about = document.querySelector('.crt p a');
        about.setAttribute('href', url)
        about.innerHTML = author;

    }, 5000);

</script>
{{/extend}}