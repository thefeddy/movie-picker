{{#extend "body_id"}}
id="landing"
{{/extend}}
{{#extend "body"}}
<div class="crt"></div>
<div class="screen">
    <h1>Search</h1>
    <div class="bg"></div>
    <div class="search">
        <form action="/search/">
            <i class="fal fa-search"></i>
            <input type="text">
            <i class="fal fa-times"></i>
        </form>
    </div>
</div>

{{/extend}}

{{#extend "js"}}
<script>
    document.querySelector('.search input').addEventListener('keyup', (event) => {
        if (event.currentTarget.value != '') {
            document.querySelector('.fa-times').classList.add('is-showing');
        } else {
            document.querySelector('.fa-times').classList.remove('is-showing');
        }
    });

    document.querySelector('.fa-times').addEventListener('click', () => {
        document.querySelector('.fa-times').classList.remove('is-showing');
        document.querySelector('.search input').value = '';
    });

    document.querySelector('.search form').addEventListener('submit', (event) => {
        event.preventDefault();
        let search = encodeURIComponent(document.querySelector('.search input').value);
        window.location.href = `/search/${search}/1`;
    });

</script>
{{/extend}}