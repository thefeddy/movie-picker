{{#extend "body_id"}}
id="search"
{{/extend}}
{{#extend "body"}}
<h1>Search</h1>
<div class="search">
    <form action="/search/">
        <i class="fal fa-search"></i>
        <input type="text">
        <i class="fal fa-times"></i>
    </form>
</div>
