{{#extend "body_id"}}
id="movie"
{{/extend}}

{{#extend "title"}}
{{ movie.title }} ||
{{/extend}}

{{#extend "body"}}
<div class="container">
    <div class="row justify-content-center">

        <div class="col-6">
            <img src="https://image.tmdb.org/t/p/w500/{{ movie.poster_path }}" />
        </div>
        <div class="col-6">
            <div class="row align-items-center">
                <div class="col-9">
                    <h1>{{ movie.original_title }}</h1>
                </div>
                <div class="col-3 status">
                    {{#if movie.added }}
                    <a href="#" data-id="{{ movie.id }}" class="{{ movie.watched }}">{{ movie.watched }}</a>
                    {{else}}
                    <a href="#" data-id="{{ movie.id }}" class="add">Add to list</a>
                    {{/if}}
                </div>
            </div>
            <div class="row">
                <p>{{ movie.overview }}</p>

                <iframe width="560" height="315" src="https://www.youtube.com/embed/{{ movie.key }}"
                    title="YouTube video player" frameborder="0"
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                    allowfullscreen></iframe>

                <a href="{{ movie.homepage }}" class="homepage" target="_blank"><span>Streaming on</span> {{
                    movie.homepage }}</a>
            </div>
        </div>
    </div>
</div>
{{/extend}}

{{#extend "js"}}
<script>

    const movie_id = `{{ movie.id }}`;
    const id = `{{ movie.added.id }}`;

    const movies = {
        add: (id) => {
            const data = {
                movie_id: id,
                watched: 0
            };
            fetch(`/add/`, {
                method: 'POST',
                body: JSON.stringify(data),
                headers: {
                    'Content-type': 'application/json'
                }

            }).then(res => res.json())
                .then((response) => {
                    console.log(response)
                })
                .catch(error => console.error('Error:', error));
        },
        watch: () => {
            let movie = {
                id,
                movie_id,
                watched: 1,
            }
            fetch(`/watched/`, {
                method: 'PUT',
                body: JSON.stringify(movie),
                headers: {
                    'Content-type': 'application/json'
                }

            }).then(res => res.json())
                .then((response) => {
                    console.log(response);

                })
                .catch(error => console.error('Error:', error));

        }
    }

    if (document.querySelector('.add')) {
        document.querySelector('.add').addEventListener('click', (event) => {
            let id = event.currentTarget.getAttribute('data-id');
            movies.add(id);
        });
    }

    if (document.querySelector('.unwatched')) {
        document.querySelector('.unwatched').addEventListener('click', (event) => {
            movies.watch();
            document.querySelector('.unwatched').innerHTML = 'watched';
            document.querySelector('.unwatched').classList.add('watched');
            document.querySelector('.unwatched').classList.add('unwatched');

        });
    }


</script>
{{/extend}}