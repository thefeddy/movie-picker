{{#extend "body_id"}}
id="movie"
{{/extend}}
{{#extend "meta"}}
<meta property="og:title" content="{{ movie.title }}" />
<meta property="og:description" content="{{ movie.overview }}" />
<meta property="og:type" content="Website" />
<meta property="og:url" content="http://c335b9642806.ngrok.io/movie/{{ movie.id }}" />
<meta property="og:image" content="https://image.tmdb.org/t/p/w500/{{ movie.poster_path }}" />
{{/extend}}
{{#extend "title"}}
{{ movie.title }} -
{{/extend}}

{{#extend "body"}}
<header>
    <div class="crt">
        {{#if movie.backdrop_path}}
        <img src="https://image.tmdb.org/t/p/original{{ movie.backdrop_path }}">
        {{else}}
        <img src="https://image.tmdb.org/t/p/original{{ movie.belongs_to_collection.backdrop_path }}">
        {{/if}}

        <div id="details">
            <h1 title="{{ movie.original_title }}">{{ movie.title }}</h1>
            <p> {{ movie.spoken_languages.0.english_name }} |
                {{#each movie.genres }}{{ this.name }}{{#unless @last}}, {{/unless}}{{/each}} |
                {{ movie.runtime }}m
            </p>
        </div>
        <div id="watch">
            {{#if movie.details }}
            {{#unless movie.watched }}
            <a href="#" data-id="{{ movie.id }}" class="unwatched">unwatched</a>
            {{/unless}}
            {{else}}
            <a href="#" data-id="{{ movie.id }}" data-title="{{ movie.title }}" class="add">Add to
                list</a>
            {{/if}}
        </div>
        <div id="watching">
            {{#unless movie.watched }}
            <div class="start-watching">Watching Movie?</div>
            {{/unless}}
        </div>
        <div id="overlay"></div>
    </div>

</header>
<div class="container">
    <div class="row justify-content-center">
        <div class="details col-12 col-md-10 col-lg-6">
            <div class="row align-items-center">
                <div class="col-12">
                    <div class="status">
                        {{#if movie.watched }}
                        <ul class="genres">
                            <li>Watched on </li>
                            <li>{{ moment movie.details.watched_on  "MMMM Do, YYYY" }}</li>
                        </ul>
                        {{else}}
                        <ul class="genres">
                            <li>Added On</li>
                            <li>{{ moment movie.details.added  "MMMM Do, YYYY" }}</li>
                        </ul>
                        {{/if}}
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-12">
                    <ul class="genres">
                        <li>Release Date</li>
                        <li>{{ moment movie.release_date  "MMMM Do, YYYY" }}</li>
                    </ul>
                </div>
                <div class="col-12">
                    <ul class="genres">
                        <li>Genres</li>
                        {{#each movie.genres }}
                        <li>{{ this.name }}</li>
                        {{/each}}
                    </ul>
                </div>
                <div class="col-12">
                    <h2>Cast</h2>
                    <ul class="scroll-section">
                        {{#each movie.cast }}
                        {{#if this.profile_path}}
                        <li>
                            <a href="/actors/{{ this.id }}" class="photo">
                                <div class="details">
                                    <div class="heading">{{ this.name }}</div>
                                    <div class="sub">{{ this.character }}</div>
                                </div>
                                <img src="https://image.tmdb.org/t/p/w500/{{ this.profile_path }}">
                            </a>
                        </li>
                        {{/if}}
                        {{/each}}
                    </ul>
                </div>

                {{#if movie.streams.flatrate }}
                <div class="col-12">
                    <h2>Stream</h2>
                    <ul class="scroll-section">
                        {{#each movie.streams.flatrate}}
                        <li>
                            <a class="photo">
                                <div class="details">
                                    <div class="heading">{{ this.provider_name }}</div>

                                </div>
                                <img src="https://image.tmdb.org/t/p/w500/{{ this.logo_path }}">
                            </a>
                        </li>
                        {{/each}}
                    </ul>
                </div>
                {{/if}}

                <p class="overview">{{ movie.overview }}</p>

                <iframe width="560" height="315" src="https://www.youtube.com/embed/{{ movie.key }}"
                    title="YouTube video player" frameborder="0"
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                    allowfullscreen></iframe>

            </div>>
            <div class="row">
                {{#if movie.streams.buy }}
                <div class="col-12">
                    <h2>Buy</h2>
                    <ul class="scroll-section">
                        {{#each movie.streams.buy}}
                        <li>
                            <a class="photo">
                                <div class="details">
                                    <div class="heading">{{ this.provider_name }}</div>

                                </div>
                                <img src="https://image.tmdb.org/t/p/w500/{{ this.logo_path }}">
                            </a>
                        </li>
                        {{/each}}
                    </ul>
                </div>
                {{/if}}

                {{#if movie.streams.rent }}
                <div class="col-12">
                    <h2>Rent</h2>
                    <ul class="scroll-section">
                        {{#each movie.streams.rent}}
                        <li>
                            <a class="photo">
                                <div class="details">
                                    <div class="heading">{{ this.provider_name }}</div>

                                </div>
                                <img src="https://image.tmdb.org/t/p/w500/{{ this.logo_path }}">
                            </a>
                        </li>
                        {{/each}}
                    </ul>
                </div>
                {{/if}}

                {{#if movie.streams.ads }}
                <div class="col-12">
                    <h2>Stream With Ads</h2>
                    <ul class="scroll-section">
                        {{#each movie.streams.ads}}
                        <li>
                            <a class="photo">
                                <div class="details">
                                    <div class="heading">{{ this.provider_name }}</div>

                                </div>
                                <img src="https://image.tmdb.org/t/p/w500/{{ this.logo_path }}">
                            </a>
                        </li>
                        {{/each}}
                    </ul>
                </div>
                {{/if}}
            </div>
        </div>
    </div>
</div> --}}
{{/extend}}

{{#extend "js"}}
<script>

    const movie_id = `{{ movie._id }}`;
    const id = `{{ movie.details.id }}`;
    let isWatching = false;
    const movies = {
        fadeOut: null,
        add: (id, title) => {
            const data = {
                movie_id: id,
                watched: 0,
                added: new Date()
            };
            fetch(`/add/`, {
                method: 'POST',
                body: JSON.stringify(data),
                headers: {
                    'Content-type': 'application/json'
                }

            }).then(res => res.json())
                .then((response) => {
                    document.querySelector('.added span').innerHTML = title;
                    document.querySelector('.added').classList.add('is-showing');
                    movies.fadeOut = setTimeout(() => {
                        document.querySelector('.added').classList.remove('is-showing');
                    }, 5000);
                })
                .catch(error => console.error('Error:', error));
        },
        watch: () => {
            let movie = {
                id,
                movie_id,
                watched: 1,
            }
            fetch(`/watched/`, {
                method: 'PUT',
                body: JSON.stringify(movie),
                headers: {
                    'Content-type': 'application/json'
                }

            }).then(res => res.json())
                .then((response) => {

                })
                .catch(error => console.error('Error:', error));
        },
        watching: () => {
            const movie = {
                id: id,
                url: window.location.href,
                movie_id: movie_id,
                title: document.querySelector('h1').innerHTML,
                poster: document.querySelector('.crt img').getAttribute('src'),
                overview: document.querySelector('.overview').innerHTML
            };
            fetch(`/watching/`, {
                method: 'POST',
                body: JSON.stringify(movie),
                headers: {
                    'Content-type': 'application/json'
                }

            }).then(res => res.json())
                .then((response) => {
                })
                .catch(error => console.error('Error:', error));
        }
    }

    if (document.querySelector('.add')) {
        document.querySelector('.add').addEventListener('click', (event) => {
            let id = event.currentTarget.getAttribute('data-id');
            let title = event.currentTarget.getAttribute('data-title');
            document.querySelector('.added').classList.remove('is-showing');
            document.querySelector('.add').classList.add('unwatched');
            document.querySelector('.add').innerHTML = 'unwatched';
            clearTimeout(movies.fadeOut);
            movies.add(id, title);

        });
    }

    if (document.querySelector('.unwatched')) {
        document.querySelector('.unwatched').addEventListener('click', (event) => {
            movies.watch();
            document.querySelector('.unwatched').innerHTML = 'watched';
            document.querySelector('.unwatched').classList.add('watched');
            document.querySelector('.unwatched').classList.add('unwatched');

        });
    }
    if (document.querySelector('.start-watching')) {
        document.querySelector('.start-watching').addEventListener('click', (event) => {
            if (!isWatching) {
                isWatching = true;
                event.currentTarget.classList.add('watching');
                event.currentTarget.innerHTML = 'Now Watching';
                document.querySelector('.unwatched').innerHTML = 'watched';
                movies.watching();
                movies.watch();
            }

        });
    }

</script>
{{/extend}}