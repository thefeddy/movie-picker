{{#extend "body_id"}}
id="movie"
{{/extend}}
{{#extend "meta"}}
<meta property="og:title" content="{{ movie.title }}" />
<meta property="og:description" content="{{ movie.overview }}" />
<meta property="og:type" content="Website" />
<meta property="og:url" content="http://c335b9642806.ngrok.io/movie/{{ movie.id }}" />
<meta property="og:image" content="https://image.tmdb.org/t/p/w500/{{ movie.poster_path }}" />
{{/extend}}
{{#extend "title"}}
{{ movie.title }} -
{{/extend}}

{{#extend "body"}}
<div class="container">
    <div class="row justify-content-between">
        <div class="poster col-12 col-md-6 col-lg-4 col-xl-5">
            <div class="crt">
                <div class="screen">
                    <img src="https://image.tmdb.org/t/p/w500{{ movie.poster_path }}" />
                </div>
            </div>
        </div>
        <div class="details col-12 col-md-10 col-lg-6  col-xl-5">
            <div class="row align-items-center">
                <div class="col-9">
                    <h1 title="{{ movie.original_title }}">{{ movie.title }}</h1>
                    {{#if movie.watched }}
                    {{#if movie.details.watched_on }}
                    <span> Watched on {{ movie.details.watched_on }}</span>
                    {{/if}}
                    {{/if}}
                </div>
                <div class="col-3 status">
                    {{#if movie.details }}
                    {{#unless movie.watched }}
                    <a href="#" data-id="{{ movie.id }}" class="unwatched">unwatched</a>
                    {{/unless}}
                    {{else}}
                    <a href="#" data-id="{{ movie.id }}" data-title="{{ movie.title }}" class="add">Add to list</a>
                    {{/if}}
                </div>
            </div>

            <div class="row">
                <div class="col-12">
                    <ul class="genres">
                        <li>Release Date</li>
                        <li>{{ movie.release_date }}</li>
                    </ul>
                </div>
                <div class="col-12">
                    <ul class="genres">
                        <li>Genres</li>
                        {{#each movie.genres }}
                        <li>{{ this.name }}</li>
                        {{/each}}
                    </ul>
                </div>
                {{#if movie.streams.flatrate }}
                <div class="col-12 streams">
                    <ul class="genres">
                        <li>Streaming On</li>

                        {{#each movie.streams.flatrate }}
                        <li><img src="https://image.tmdb.org/t/p/original/{{ this.logo_path }}"></li>
                        {{/each}}
                    </ul>
                </div>
                {{/if}}
                <div class="col-12">
                    <ul class="scroll-section">
                        {{#each movie.cast }}
                        {{#if this.profile_path}}
                        <li>
                            <a href="/actors/{{ this.id }}" class="photo">
                                <div class="details">
                                    <div class="heading">{{ this.name }}</div>
                                    <div class="sub">{{ this.character }}</div>
                                </div>
                                <img src="https://image.tmdb.org/t/p/w500/{{ this.profile_path }}">
                            </a>
                        </li>
                        {{/if}}
                        {{/each}}
                    </ul>
                </div>

                <p>{{ movie.overview }}</p>

                <iframe width="560" height="315" src="https://www.youtube.com/embed/{{ movie.key }}"
                    title="YouTube video player" frameborder="0"
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                    allowfullscreen></iframe>

            </div>
            <div class="row">
                {{#unless movie.watched }}
                <div class="start-watching">Watching Movie?</div>
                {{/unless}}
                {{!-- {{#if movie.homepage }}
                <a href="{{ movie.homepage }}" class="homepage" target="_blank"><span>Streaming on</span> {{
                    movie.homepage }}</a>
                {{/if}} --}}
            </div>

        </div>
    </div>
</div>
{{/extend}}

{{#extend "js"}}
<script>

    const movie_id = `{{ movie._id }}`;
    const id = `{{ movie.details.id }}`;
    let isWatching = false;
    const movies = {
        fadeOut: null,
        add: (id, title) => {
            const data = {
                movie_id: id,
                watched: 0,
                added: new Date()
            };
            fetch(`/add/`, {
                method: 'POST',
                body: JSON.stringify(data),
                headers: {
                    'Content-type': 'application/json'
                }

            }).then(res => res.json())
                .then((response) => {
                    document.querySelector('.added span').innerHTML = title;
                    document.querySelector('.added').classList.add('is-showing');
                    movies.fadeOut = setTimeout(() => {
                        document.querySelector('.added').classList.remove('is-showing');
                    }, 5000);
                })
                .catch(error => console.error('Error:', error));
        },
        watch: () => {
            let movie = {
                id,
                movie_id,
                watched: 1,
            }
            fetch(`/watched/`, {
                method: 'PUT',
                body: JSON.stringify(movie),
                headers: {
                    'Content-type': 'application/json'
                }

            }).then(res => res.json())
                .then((response) => {

                })
                .catch(error => console.error('Error:', error));
        },
        watching: () => {
            const movie = {
                id: id,
                url: window.location.href,
                movie_id: movie_id,
                title: document.querySelector('h1').innerHTML,
                poster: document.querySelector('.poster img').getAttribute('src'),
                overview: document.querySelector('p').innerHTML
            };
            fetch(`/watching/`, {
                method: 'POST',
                body: JSON.stringify(movie),
                headers: {
                    'Content-type': 'application/json'
                }

            }).then(res => res.json())
                .then((response) => {
                })
                .catch(error => console.error('Error:', error));
        }
    }

    if (document.querySelector('.add')) {
        document.querySelector('.add').addEventListener('click', (event) => {
            let id = event.currentTarget.getAttribute('data-id');
            let title = event.currentTarget.getAttribute('data-title');
            document.querySelector('.added').classList.remove('is-showing');
            document.querySelector('.add').classList.add('unwatched');
            document.querySelector('.add').innerHTML = 'unwatched';
            clearTimeout(movies.fadeOut);
            movies.add(id, title);

        });
    }

    if (document.querySelector('.unwatched')) {
        document.querySelector('.unwatched').addEventListener('click', (event) => {
            movies.watch();
            document.querySelector('.unwatched').innerHTML = 'watched';
            document.querySelector('.unwatched').classList.add('watched');
            document.querySelector('.unwatched').classList.add('unwatched');

        });
    }

    document.querySelector('.start-watching').addEventListener('click', (event) => {
        if (!isWatching) {
            isWatching = true;
            event.currentTarget.classList.add('watching');
            event.currentTarget.innerHTML = 'Now Watching';
            document.querySelector('.unwatched').innerHTML = 'watched';
            movies.watching();
            movies.watch();
        }

    });
</script>
{{/extend}}